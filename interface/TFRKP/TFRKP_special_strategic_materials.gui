		# Toggling the container creates a real show event for the non-looping child.
		# Frame 0 and the final frame are both fully transparent, so a failed start
		# can never leave the document background permanently visible.
		containerWindowType = {
			name = "KOR_ssm_signature_completion_container"
			size = { width = 168 height = 162 }
			position = { x = 285 y = 22 }
