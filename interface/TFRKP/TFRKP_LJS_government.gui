guiTypes = {
	containerWindowType = {
		name = "TFR_KOR_LJS_government_gui_window"
		clipping = no
		size = { width = 500 height = 220 }

		containerWindowType = {
			name = "line_graph_ljs_gui"
			position = { x = 0 y = -20 }
			size = { width = 500 height = 250 }
			clipping = no
			orientation = center
			origo = center
			moveable = yes

			background = {
				name = "LJS_government_background_frame"
				spriteType = "GFX_LJS_government_background_frame"
				position = { x = 0 y = 22 }
				size = { x = 476 y = 220 }
				alwaystransparent = yes
			}
			
			# Chart background
			iconType = {
				name = "chart"
				spriteType = "GFX_LJS_line_graph_chart"
				position = { x = 68 y = 90 }
			}

			# Container which will hold each of our line segments
			gridboxtype = {
				name = "LJS_government_positive"
				position = { x = 82 y = 86 }
				size = { width = 0 height = 200 }
				slotsize = { width = 20 height = 200 }
				max_slots_horizontal = 20
				add_horizontal = yes
			}
			gridboxtype = {
				name = "LJS_government_negative"
